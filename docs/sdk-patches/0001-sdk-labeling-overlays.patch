diff --git a/packages/ui/src/components/viewport3d/renderers/AnnotationRenderer.tsx b/packages/ui/src/components/viewport3d/renderers/AnnotationRenderer.tsx
new file mode 100644
index 0000000..da16544
--- /dev/null
+++ b/packages/ui/src/components/viewport3d/renderers/AnnotationRenderer.tsx
@@ -0,0 +1,50 @@
+import {useEffect, useMemo, useSyncExternalStore} from 'react';
+import {BufferAttribute, BufferGeometry, Color, Matrix4} from 'three';
+import {workerDataStore} from '../WorkerDataStore';
+import {useReferenceTransform} from '../scene/ReferenceFrame';
+import type {SceneAnnotations} from '../scene-annotations';
+
+type Segment = SceneAnnotations['segments'][number];
+
+function segmentGeometry(segments: readonly Segment[]): BufferGeometry {
+    const positions = new Float32Array(segments.length * 6);
+    const colors = new Float32Array(segments.length * 6);
+    const color = new Color();
+    segments.forEach((segment, index) => {
+        positions.set([...segment.start, ...segment.end], index * 6);
+        color.set(segment.color);
+        colors.set([color.r, color.g, color.b, color.r, color.g, color.b], index * 6);
+    });
+    const geometry = new BufferGeometry();
+    geometry.setAttribute('position', new BufferAttribute(positions, 3));
+    geometry.setAttribute('color', new BufferAttribute(colors, 3));
+    return geometry;
+}
+
+function SegmentLines({segments, dashed}: {segments: readonly Segment[]; dashed: boolean}) {
+    const geometry = useMemo(() => segmentGeometry(segments), [segments]);
+    useEffect(() => () => geometry.dispose(), [geometry]);
+    if (!segments.length) return null;
+    return <lineSegments geometry={geometry} onUpdate={line => { if (dashed) line.computeLineDistances(); }}>
+        {dashed
+            ? <lineDashedMaterial vertexColors dashSize={12} gapSize={8} transparent opacity={0.9}/>
+            : <lineBasicMaterial vertexColors transparent opacity={0.9}/>}
+    </lineSegments>;
+}
+
+/** Draws the application's points and rays in calibration world coordinates. */
+export function AnnotationRenderer() {
+    const annotations = useSyncExternalStore(workerDataStore.subscribeToAnnotations, workerDataStore.getAnnotations);
+    const referenceTransform = useReferenceTransform();
+    const solid = useMemo(() => annotations.segments.filter(segment => !segment.dashed), [annotations]);
+    const dashed = useMemo(() => annotations.segments.filter(segment => segment.dashed), [annotations]);
+    if (!annotations.points.length && !annotations.segments.length) return null;
+    return <group name="Application annotations" matrix={referenceTransform ?? new Matrix4()} matrixAutoUpdate={false}>
+        <SegmentLines segments={solid} dashed={false}/>
+        <SegmentLines segments={dashed} dashed={true}/>
+        {annotations.points.map(point => <mesh key={point.id} position={point.position}>
+            <sphereGeometry args={[point.radiusMm, 16, 12]}/>
+            <meshBasicMaterial color={point.color}/>
+        </mesh>)}
+    </group>;
+}
diff --git a/packages/ui/src/components/viewport3d/scene-annotations.ts b/packages/ui/src/components/viewport3d/scene-annotations.ts
new file mode 100644
index 0000000..79da644
--- /dev/null
+++ b/packages/ui/src/components/viewport3d/scene-annotations.ts
@@ -0,0 +1,26 @@
+import {z} from 'zod';
+
+const Vector3Schema = z.tuple([z.number(), z.number(), z.number()]);
+const HexColorSchema = z.string().regex(/^#[0-9a-fA-F]{6}$/);
+
+/**
+ * Application-owned 3D markup drawn in calibration world coordinates (mm), under the same
+ * reference transform as the camera frustums. The SDK draws exactly what it is given.
+ */
+export const SceneAnnotationsSchema = z.object({
+    points: z.array(z.object({
+        id: z.string(),
+        position: Vector3Schema,
+        color: HexColorSchema,
+        radiusMm: z.number().positive(),
+    })),
+    segments: z.array(z.object({
+        id: z.string(),
+        start: Vector3Schema,
+        end: Vector3Schema,
+        color: HexColorSchema,
+        dashed: z.boolean(),
+    })),
+});
+export type SceneAnnotations = z.infer<typeof SceneAnnotationsSchema>;
+export const EMPTY_SCENE_ANNOTATIONS: SceneAnnotations = {points: [], segments: []};
