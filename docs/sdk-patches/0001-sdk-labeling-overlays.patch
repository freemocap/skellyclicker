+/**
+ * Image-space overlay slot. The element is rendered inside the tile's zoom transform and fills the
+ * same box as the presented image, which is drawn with object-fit contain anchored center top.
+ * Draw in source pixels with an SVG `viewBox="0 0 imageWidth imageHeight"` and
+ * `preserveAspectRatio="xMidYMin meet"`; the overlay then tracks zoom and pan exactly.
+ * Pointer events on the overlay bubble to the tile, so drag-to-pan keeps working.
+ */
+export interface ImageOverlayContext {
+    readonly videoId:string;
+    readonly filename:string;
+    /** Decoded video size in source pixels. */
+    readonly imageWidth:number;
+    readonly imageHeight:number;
+    pause():void;
+    /** Read on click: null while seeking or before a committed image exists. */
+    getPresentedFrame():PresentedImage|null;
+}
